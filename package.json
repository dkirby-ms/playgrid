{
  "name": "@eschaton/playgrid",
  "private": true,
  "version": "0.2.20",
  "type": "module",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w client\" \"npm run dev -w server\"",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "build": "npm run build -w shared && npm run build -w server && npm run build -w client",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "audit": "npm audit --omit=dev --audit-level=high --workspaces --include-workspace-root --if-present",
    "release": "semantic-release --extends ./.releaserc.cjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "concurrently": "^9.0.0",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "eslint": "^10.0.3",
    "globals": "^17.4.0",
    "semantic-release": "^25.0.9",
    "tsx": "4.21.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.0.18"
  }
}
